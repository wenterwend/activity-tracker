# Combined reference for all environment variables in this project.
#
# DO NOT fill values in here — use the per-package templates:
#   app/backend/.env.example  →  copy to  app/backend/.env
#   app/frontend/.env.example →  copy to  app/frontend/.env
#
# ── backend/.env ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
PORT=4000
FRONTEND_URL=http://localhost:5173
ANTHROPIC_API_KEY=sk-ant-...

# ── frontend/.env ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
VITE_API_URL=http://localhost:4000
