# Copy this file to .env and fill in every value before starting the server.
# Never commit .env — it contains live credentials.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and anon key: Supabase Dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
# Must match the URL your frontend dev server runs on (CORS allow-list)
FRONTEND_URL=http://localhost:5173

# ── Anthropic (AI summary feature) ───────────────────────────────────────────
# Get your key at https://console.anthropic.com → API Keys
# Leave blank to disable the AI summary panel without breaking the rest of the app.
ANTHROPIC_API_KEY=sk-ant-...
