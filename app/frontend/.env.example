# Copy this file to .env and fill in every value before running the dev server.
# Never commit .env — it contains live credentials.
# All variables must be prefixed with VITE_ to be exposed to the browser bundle.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and anon key: Supabase Dashboard → Settings → API
# The anon key is safe to expose in the browser — it is a publishable key.
# Row Level Security on every table limits what it can access.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# ── Backend API ───────────────────────────────────────────────────────────────
# URL of the Express backend (must match PORT in backend/.env)
VITE_API_URL=http://localhost:4000
